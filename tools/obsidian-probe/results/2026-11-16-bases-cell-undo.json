    "sources": {
     "undoTransaction": "async undoTransaction(){if(this.undoStack.length===0)return;let e=this.undoStack.pop();this.redoStack.push(e),this.setEphemeralState(e.state);for(let i of e.changes)await this.app.fileManager.processFrontMatter(i.file,r=>{JSON.stringify(r)===JSON.stringify(i.end)&&Object.assign(r,i.start)})}",
     "redoTransaction": "async redoTransaction(){if(this.redoStack.length==0)return;let e=this.redoStack.pop();this.undoStack.push(e),this.setEphemeralState(e.state);for(let i of e.changes)await this.app.fileManager.processFrontMatter(i.file,r=>{JSON.stringify(r)===JSON.stringify(i.start)&&Object.assign(r,i.end)})}",
     "pushUndoHistory": "pushUndoHistory(e,i,r){if(!e)return;let n=e.getViewState();if(n.type===\"empty\")return;let a=e.getEphemeralState(),{undoHistory:s}=this;s.unshift({leafId:e.id,state:n,eState:a,parentId:i,rootId:r,leafHistory:e.history.serialize()}),s.length>10&&s.pop()}",
     "hasUndoHistory": "hasUndoHistory(){return this.undoHistory.length>0}",
     "notifyForBulkUndo": "notifyForBulkUndo(t,e=3e4){t.length!==0&&new R(w.dialogue.msgFilesUpdated({count:t.length}),e).addButton(w.dialogue.buttonUndo(),()=>{this.updateQueue.queue(async()=>{let{vault:i}=this.app;for(let{file:r,mtime:n,content:a}of t)await i.modify(r,a,{mtime:n});new R(w.dialogue.msgFilesReverted({count:t.length}))})})}"
    },
